# PyGovPub SDK Configuration
# ================================

# Environment
# -----------
# Options: development, test, production
PYGOVPUB_ENV=development

# Mock Server
# -----------
# Enable mock server (true/false)
PYGOVPUB_MOCK_ENABLED=true

# Simulate API latency in milliseconds
PYGOVPUB_MOCK_LATENCY_MS=100

# Simulate API rate limits (true/false)
PYGOVPUB_MOCK_SIMULATE_RATE_LIMITS=false

# Enable recording mode to capture real API responses (true/false)
PYGOVPUB_MOCK_RECORD_MODE=false

# Path to fixtures directory (relative to package)
PYGOVPUB_MOCK_FIXTURES_PATH=fixtures

# Congress.gov API
# ----------------
# Your Congress.gov API key (required for production)
CONGRESS_GOV_API_KEY=

# Congress.gov API base URL (override default)
# CONGRESS_GOV_API_URL=https://api.congress.gov/v3

# Congress.gov API rate limit (default: 5000 requests/hour)
# CONGRESS_GOV_RATE_LIMIT=5000

# GovInfo.gov API
# ---------------
# Your GovInfo.gov API key (required for production)
GOVINFO_API_KEY=

# GovInfo.gov API base URL (override default)
# GOVINFO_API_URL=https://api.govinfo.gov

# GovInfo.gov API rate limit (default: 1000 requests/hour)
# GOVINFO_RATE_LIMIT=1000